# Copy to .env and fill in. Never commit .env.

# ---- Which LiteLLM config to use: azure | openai | anthropic (deploy/litellm/config.<x>.yaml)
LLM_PROVIDER=azure
LITELLM_MASTER_KEY=sk-p2pilot-dev-change-me
# Port on your PC for the gateway (4000 is used by NoMachine)
LITELLM_HOST_PORT=4001

# Azure OpenAI via Foundry (if LLM_PROVIDER=azure). Deployment names are in deploy/litellm/config.azure.yaml
AZURE_API_BASE=https://p2pilotproject.openai.azure.com
AZURE_API_KEY=
AZURE_API_VERSION=2024-10-21

# DeepSeek - fallback provider for the fast/reasoning aliases (platform.deepseek.com)
DEEPSEEK_API_KEY=

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (if LLM_PROVIDER=anthropic) - from platform.claude.com, not your Claude Pro plan
ANTHROPIC_API_KEY=

# ---- API
# Set LLM_FAKE=true to run with no LLM keys at all (deterministic fake replies).
LLM_FAKE=false
LITELLM_BASE_URL=http://localhost:4001
AUTH_DISABLED=false

# ---- Supabase (values from `supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only if your local stack signs with a shared secret (shown as "JWT secret" in `supabase status`).
# Leave empty to verify tokens with the stack's JWKS.
SUPABASE_JWT_SECRET=
P2PILOT_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Seeder
SEED_USER_PASSWORD=P2Pilot!dev123

# ---- Sprint 3
NEO4J_PASSWORD=p2pilot-dev-pass

# ---- Sprint 2.5: where LangGraph run state lives (auto = Postgres when P2PILOT_DB_URL is set)
CHECKPOINTER=auto
